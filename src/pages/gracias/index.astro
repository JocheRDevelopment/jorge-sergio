---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrimaryCta from '../../components/cta/PrimaryCta.astro';

const title = 'Cita confirmada — Gracias';
const description = 'Tu sesión con Jorge Sergio Ramírez quedó agendada.';
---

<BaseLayout title={title} description={description} noindex>
  <section
    class="flex min-h-[70vh] flex-col items-center justify-center bg-gradient-to-br from-navy-900 via-navy-700 to-navy-600 px-6 py-24 text-center md:px-16"
  >
    <div class="mb-7 grid h-16 w-16 place-items-center rounded-full bg-gold-500" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0d1b30" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5" />
      </svg>
    </div>
    <h1 class="mb-4 max-w-[560px] font-serif text-[30px] font-semibold text-bone-50 md:text-[38px]">
      Tu sesión quedó agendada
    </h1>
    <p class="mb-10 max-w-[520px] text-[16px] leading-[1.7] text-slate-400">
      Revisa tu correo — ahí tienes la confirmación y el enlace de acceso a la videollamada. Antes de la sesión,
      ten a la mano el contexto de tu reto actual para aprovechar al máximo los 30 minutos.
    </p>
    <PrimaryCta href="/" variant="outline">Volver al inicio</PrimaryCta>
  </section>
</BaseLayout>

<script>
  // Conversión de analítica al llegar a la página de gracias — el redirect
  // se configura dentro de Calendly (Confirmation Page) apuntando aquí.
  // TODO: conectar GA4/Meta Pixel reales; por ahora solo alimenta dataLayer
  // si existe, sin fallar si no hay ninguna herramienta instalada todavía.
  // @ts-expect-error -- dataLayer es un global inyectado por GTM/GA4 cuando exista.
  window.dataLayer = window.dataLayer || [];
  // @ts-expect-error -- ídem
  window.dataLayer.push({ event: 'booking_confirmed' });
</script>
