---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustStrip from '../../components/sections/TrustStrip.astro';
import CalEmbed from '../../components/cal/CalEmbed.astro';
import { breadcrumbSchema } from '../../lib/schema';

const title = 'Agenda tu Sesión sin Costo | Diagnóstico Comercial o Retiro';
const description =
  'Agenda en 30 segundos tu sesión sin costo: diagnóstico comercial (CMV) o estrategia de plan personal de retiro (PPR). Confirmación automática, sin llamadas de venta.';

const jsonLd = breadcrumbSchema([
  { name: 'Inicio', path: '/' },
  { name: 'Agenda tu sesión', path: '/agenda/' },
]);
---

<BaseLayout title={title} description={description} appendBrand={false} jsonLd={jsonLd}>
  <section class="relative overflow-hidden bg-gradient-to-br from-navy-900 via-navy-700 to-navy-600 px-6 py-20 md:px-16 md:py-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.08]"
      style="background-image: repeating-linear-gradient(115deg, rgba(201,162,39,0.6) 0px, rgba(201,162,39,0.6) 1px, transparent 1px, transparent 42px);"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-[720px] text-center">
      <h1 class="mb-5 font-serif text-[32px] font-semibold leading-[1.2] text-bone-50 md:text-[44px]">
        Agenda tu sesión con Jorge Sergio
      </h1>
      <p class="mx-auto max-w-[600px] text-[17px] leading-[1.6] text-slate-400">
        25 minutos. Sin costo. Elige tu horario.
      </p>
      <div class="mt-9">
        <TrustStrip />
      </div>
    </div>
  </section>

  <section class="bg-gradient-to-b from-bone-100 to-bone-50 px-6 py-16 md:px-16">
    <CalEmbed theme="light" />
  </section>
</BaseLayout>
