---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { breadcrumbSchema } from '../../../lib/schema';
import { PILLARS, getPublishedPosts, pillarPath, type Pillar, type Post } from '../../../lib/blog';

// Solo se generan los pilares que tienen al menos un artículo publicado.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const pillars = [...new Set(posts.map((p) => p.data.pillar))];
  return pillars.map((pillar) => ({
    params: { pillar },
    props: { pillar, posts: posts.filter((p) => p.data.pillar === pillar) },
  }));
}

interface Props {
  pillar: Pillar;
  posts: Post[];
}
const { pillar, posts } = Astro.props;
const label = PILLARS[pillar];

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: label, path: pillarPath(pillar) },
];
---

<BaseLayout
  title={`${label} — Blog`}
  description={`Artículos de ${label.toLowerCase()} por Jorge Sergio Ramírez: guías prácticas y respuestas claras, sin rodeos.`}
  jsonLd={breadcrumbSchema(crumbs)}
>
  <section class="mx-auto max-w-[1140px] px-6 py-16 md:px-16">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mb-12 mt-6 font-serif text-[32px] font-semibold text-navy-800 md:text-[42px]">{label}</h1>
    <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
