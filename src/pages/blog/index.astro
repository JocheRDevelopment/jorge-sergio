---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/blog/Breadcrumbs.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
---

<BaseLayout
  title="Blog"
  description="Artículos de Jorge Sergio Ramírez sobre plan de retiro, finanzas personales, ventas y coaching: guías prácticas y respuestas claras."
  noindex={posts.length === 0}
  jsonLd={breadcrumbSchema(crumbs)}
>
  <section class="mx-auto max-w-[1140px] px-6 py-16 md:px-16">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mb-12 mt-6 font-serif text-[32px] font-semibold text-navy-800 md:text-[42px]">Blog</h1>
    {
      posts.length > 0 ? (
        <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <p class="text-[16px] text-ink-800">Muy pronto publicaremos los primeros artículos.</p>
      )
    }
  </section>
</BaseLayout>
