---
import { PILLARS, formatDate, pillarPath, postPath, type Post } from '../../lib/blog';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<article class="flex flex-col rounded-[4px] border border-line-200 bg-white p-7">
  <a
    href={pillarPath(post.data.pillar)}
    class="mb-3 text-[12px] font-semibold uppercase tracking-[1.2px] text-gold-500 hover:text-gold-300"
  >
    {PILLARS[post.data.pillar]}
  </a>
  <h2 class="mb-3 font-serif text-[22px] font-semibold leading-[1.3]">
    <a href={postPath(post)} class="text-navy-800 hover:text-gold-500">{post.data.title}</a>
  </h2>
  <p class="mb-5 text-[14.5px] leading-[1.7] text-ink-800">{post.data.description}</p>
  <time datetime={post.data.pubDate.toISOString()} class="mt-auto text-[12.5px] text-slate-500">
    {formatDate(post.data.pubDate)}
  </time>
</article>
