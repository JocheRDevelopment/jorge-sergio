---
interface Crumb {
  name: string;
  path: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Ruta de navegación" class="text-[13px] text-slate-500">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      crumbs.map((c, i) => {
        const isLast = i === crumbs.length - 1;
        return (
          <li class="flex items-center gap-1.5">
            {isLast ? (
              <span aria-current="page" class="text-ink-800">
                {c.name}
              </span>
            ) : (
              <>
                <a href={c.path} class="text-slate-500 hover:text-gold-500">
                  {c.name}
                </a>
                <span aria-hidden="true">›</span>
              </>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
