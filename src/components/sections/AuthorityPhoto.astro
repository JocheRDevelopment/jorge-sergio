---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
  eyebrow: string;
  title: string;
  paragraph: string;
  quote: string;
  linkLabel: string;
  linkHref: string;
}

const {
  image,
  imageAlt,
  imagePosition = 'object-top',
  eyebrow,
  title,
  paragraph,
  quote,
  linkLabel,
  linkHref,
} = Astro.props;
---

<section class="grid gap-14 bg-white px-6 py-20 md:gap-16 md:px-16 md:py-[100px] lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
  <div class="relative flex min-h-[320px] flex-col justify-end overflow-hidden rounded-[4px] border border-gold-500/25 p-10 md:min-h-[420px]">
    <Image
      src={image}
      alt={imageAlt}
      width={880}
      height={655}
      class:list={['absolute inset-0 h-full w-full object-cover', imagePosition]}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-900/95 via-navy-900/40 to-transparent" aria-hidden="true" />
    <div class="relative">
      <div class="mb-6 h-[3px] w-16 bg-gold-500" />
      <p class="font-serif text-[24px] italic leading-[1.5] text-gold-100 md:text-[28px]">"{quote}"</p>
    </div>
  </div>

  <div>
    <p class="mb-4 text-[13px] font-semibold uppercase tracking-[1.4px] text-gold-500">{eyebrow}</p>
    <h2 class="mb-6 font-serif text-[28px] font-semibold leading-[1.25] text-navy-800 md:text-[32px]">
      {title}
    </h2>
    <p class="mb-5 text-[16px] leading-[1.75] text-ink-700">
      {paragraph}
    </p>
    <a href={linkHref} class="text-[14.5px] font-semibold text-gold-500 hover:text-gold-300">
      {linkLabel} &rarr;
    </a>
  </div>
</section>
