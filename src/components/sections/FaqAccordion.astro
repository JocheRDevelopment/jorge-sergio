---
interface Entry {
  question: string;
  answer: string;
}
interface Props {
  entries: Entry[];
  eyebrow?: string;
  title?: string;
  theme?: 'dark' | 'light';
}
const { entries, eyebrow = 'Preguntas frecuentes', title = 'Antes de agendar', theme = 'light' } =
  Astro.props;

const sectionBg = theme === 'dark' ? 'bg-navy-900' : 'bg-white';
const titleColor = theme === 'dark' ? 'text-bone-50' : 'text-navy-800';
const border = theme === 'dark' ? 'border-gold-500/25' : 'border-line-200';
const summaryColor = theme === 'dark' ? 'text-bone-50' : 'text-navy-800';
const bodyColor = theme === 'dark' ? 'text-slate-400' : 'text-ink-800';
---

<section class:list={['px-6 py-20 md:px-16 md:py-[100px]', sectionBg]}>
  <div class="mx-auto max-w-[760px]">
    <div class="mb-12 text-center">
      <p class="mb-3.5 text-[13px] font-semibold uppercase tracking-[1.4px] text-gold-500">{eyebrow}</p>
      <h2 class:list={['font-serif text-[28px] font-semibold md:text-[36px]', titleColor]}>{title}</h2>
    </div>
    <div class="flex flex-col gap-3">
      {
        entries.map((e) => (
          <details class:list={['group rounded-[4px] border px-6 py-2', border]}>
            <summary class:list={['flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15.5px] font-semibold', summaryColor]}>
              {e.question}
              <span class="shrink-0 text-gold-500 transition-transform group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class:list={['pb-5 text-[14.5px] leading-[1.7]', bodyColor]}>{e.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
