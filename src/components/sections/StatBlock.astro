---
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<div class="rounded-[4px] border border-line-200 bg-white p-7 text-center">
  <div class="font-serif text-[34px] font-bold text-navy-800">{value}</div>
  <div class="mt-1.5 text-[13.5px] text-ink-700">{label}</div>
</div>
