---
// Barra CTA fija inferior, solo móvil — el objetivo de negocio del sitio es
// agendar, así que en pantallas pequeñas el CTA nunca debe requerir scroll.
// Se oculta automáticamente cuando el usuario ya está en /agenda/.
const hide = Astro.url.pathname.startsWith('/agenda');
---

{
  !hide && (
    <div class="fixed inset-x-0 bottom-0 z-40 border-t border-gold-500/30 bg-navy-900/95 p-3 backdrop-blur lg:hidden">
      <a
        href="/agenda/"
        class="flex min-h-[48px] w-full items-center justify-center rounded-[3px] bg-gold-500 px-6 text-[14.5px] font-semibold text-navy-900 hover:bg-gold-300"
        style="padding-bottom: env(safe-area-inset-bottom, 0px);"
      >
        Agenda tu sesión
      </a>
    </div>
  )
}
