---
import LogoStrip from '../sections/LogoStrip.astro';
import { navLinks } from '../../config/site';
import { getPublishedPosts } from '../../lib/blog';

const links = navLinks((await getPublishedPosts()).length > 0);
const year = new Date().getFullYear();
---

<footer class="bg-navy-900 px-6 py-12 md:px-16">
  <div class="flex flex-wrap items-center justify-between gap-5">
    <div class="font-serif text-[17px] text-slate-400">Jorge Sergio Ramírez Lizárraga</div>
    <div class="flex flex-wrap gap-7">
      {
        links.map((link) => (
          <a href={link.href} class="text-[13.5px] text-slate-500 hover:text-gold-300">
            {link.label}
          </a>
        ))
      }
      <a href="/agenda/" class="text-[13.5px] text-slate-500 hover:text-gold-300">Agenda tu sesión</a>
      <a href="/aviso-de-privacidad/" class="text-[13.5px] text-slate-500 hover:text-gold-300">Aviso de Privacidad</a>
    </div>
    <div class="text-[12.5px] text-ink-700">&copy; {year} &middot; Coaching de Ventas &amp; Plan de Retiro</div>
  </div>

  <div class="mt-10 border-t border-white/10 pt-8">
    <LogoStrip variant="footer" />
  </div>
</footer>
