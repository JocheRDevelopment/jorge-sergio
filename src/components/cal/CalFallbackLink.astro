---
import { CAL_URL } from '../../config/site';

interface Props {
  class?: string;
  linkId?: string;
}
const { class: className = '', linkId } = Astro.props;
---

<p class:list={['text-[13px] text-slate-400', className]} data-cal-fallback>
  ¿El calendario no carga?{' '}
  <a
    id={linkId}
    href={CAL_URL}
    target="_blank"
    rel="noopener"
    class="font-semibold text-gold-500 hover:text-gold-300"
  >
    Abre el enlace directo de Cal.com
  </a>
</p>
