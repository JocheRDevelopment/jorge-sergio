---
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';
import FontPreload from '../components/seo/FontPreload.astro';
import OrganizationSchema from '../components/seo/OrganizationSchema.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/footer/Footer.astro';
import StickyMobileCta from '../components/cta/StickyMobileCta.astro';
import { SITE_NAME } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  ogType?: 'website' | 'profile' | 'article';
  appendBrand?: boolean;
  /** Schema JSON-LD específico de la página (Service, Person, FAQPage, BreadcrumbList...). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** href del CTA del header (p. ej. con UTMs de la página). */
  ctaHref?: string;
  /** Si es false, no se muestra la barra CTA fija global en móvil (la página trae la suya). */
  stickyCta?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  canonical,
  noindex,
  ogType,
  appendBrand,
  jsonLd,
  ctaHref,
  stickyCta = true,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1b30" />
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      canonical={canonical}
      noindex={noindex}
      ogType={ogType}
      appendBrand={appendBrand}
    />
    <link rel="alternate" type="application/rss+xml" title={`Blog | ${SITE_NAME}`} href="/rss.xml" />
    <FontPreload />
    <OrganizationSchema />
    {jsonLd && <JsonLd schema={jsonLd} />}
    <slot name="head" />
  </head>
  <body class:list={[stickyCta && 'pb-16 lg:pb-0']}>
    <Nav ctaHref={ctaHref} />
    <main>
      <slot />
    </main>
    <Footer />
    {stickyCta && <StickyMobileCta />}
  </body>
</html>
